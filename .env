REGISTRY=gcr.io/etcd-development/etcd
ETCD_VERSION=v3.6.0

# Node names
NAME_1=etcd-node-1
NAME_2=etcd-node-2
NAME_3=etcd-node-3

# Hostnames: must match docker-compose service names so DNS resolves inside the network
HOST_1=etcd1
HOST_2=etcd2
HOST_3=etcd3

# Cluster
TOKEN=my-etcd-token
CLUSTER_STATE=new
CLUSTER=etcd-node-1=http://etcd1:2380,etcd-node-2=http://etcd2:2380,etcd-node-3=http://etcd3:2380

# etcd data directory
DATA_DIR=/var/lib/etcd

# Registry
REGISTRY_PORT=8500
 
# Service ports
SERVICE_B1_PORT=9001
SERVICE_B2_PORT=9002
SERVICE_A_PORT=9100
